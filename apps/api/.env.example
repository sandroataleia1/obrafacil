APP_NAME=ObraFacil
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=obrafacil
DB_USERNAME=obrafacil
DB_PASSWORD=obrafacil

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Sanctum SPA (session/cookie auth, no Bearer token/localStorage for web).
# Comma-separated hosts (no scheme) that receive stateful auth cookies.
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Frontend origin(s) allowed by CORS with credentials. Comma-separated for
# multiple origins later (e.g. web.obrafacil..., api.obrafacil...) — no
# client domain (JVW or otherwise) is hardcoded here.
FRONTEND_URL=http://localhost:3000

# Evolution API (WhatsApp provider) — private, server-side only. Never
# exposed to apps/web (no NEXT_PUBLIC_EVOLUTION_*), and no real key ever
# goes in this repo — placeholders only. Not configured against the real
# VPS instance yet (see EVOLUTION-01).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_TIMEOUT_SECONDS=10
EVOLUTION_WEBHOOK_SECRET=

# CEP/CNPJ lookup providers (BACKEND-04A) — public, read-only, server-side
# only. Never NEXT_PUBLIC_*: the frontend never talks to ViaCEP/BrasilAPI
# directly, only to ObraFácil's own /api/v1/lookups/* endpoints.
VIACEP_BASE_URL=https://viacep.com.br
BRASILAPI_BASE_URL=https://brasilapi.com.br/api
LOOKUP_HTTP_TIMEOUT=5
LOOKUP_CEP_CACHE_TTL=86400
LOOKUP_CNPJ_CACHE_TTL=21600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
