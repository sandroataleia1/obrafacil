<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            <server> (which PHPUnit always writes straight into $_SERVER),
            not <env>: compose.yaml's `environment:` block (APP_ENV, DB_*)
            sets these as real container-level env vars, which land in
            $_SERVER before PHPUnit runs. Laravel's Env repository reads
            $_SERVER ahead of getenv()/$_ENV, so even <env ... force="true">
            (which only touches putenv()/$_ENV) was silently losing to the
            container's real APP_ENV=local — the whole suite was quietly
            running against the dev database instead of obrafacil_test, with
            APP_ENV stuck on "local" instead of "testing".
        -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_HOST" value="postgres" force="true"/>
        <server name="DB_PORT" value="5432" force="true"/>
        <server name="DB_DATABASE" value="obrafacil_test" force="true"/>
        <server name="DB_USERNAME" value="obrafacil" force="true"/>
        <server name="DB_PASSWORD" value="obrafacil" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000" force="true"/>
        <server name="FRONTEND_URL" value="http://localhost:3000" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
