# Production artifact for the ObraFácil pilot (PILOT-04A).
#
# Separate from `Dockerfile` (development, `pnpm dev`, bind-mounted
# source, hot reload) — that file is untouched and keeps working
# exactly as before for local development via `compose.yaml`.
#
# Build context is `./apps/web` (see `compose.pilot.yaml`), so every
# COPY below is relative to that directory — including its own
# self-contained `package.json`/`pnpm-lock.yaml`/`pnpm-workspace.yaml`
# (this app already installs standalone from its own lockfile, not the
# monorepo root one — confirmed by the existing dev `Dockerfile` using
# the same pattern).
#
# `deps` -> `builder` -> `runner`: the runner stage never sees pnpm,
# the toolchain, or full `node_modules` — only what `next build`'s
# `output: "standalone"` traced as actually needed at runtime.

FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Public, non-secret build identifier (Pilot-Ready "PILOT-03 —
# Identificação de Release") — must be present *before* `pnpm build`:
# Next.js inlines `NEXT_PUBLIC_*` values into the client bundle at
# build time, never reads them at runtime. Omitted at build time ->
# `release-info.ts` falls back to the literal "local", it never fails
# the build.
ARG NEXT_PUBLIC_BUILD_SHA
ENV NEXT_PUBLIC_BUILD_SHA=$NEXT_PUBLIC_BUILD_SHA

# Pilot configuration (Pilot-Ready "PILOT-CLEAN" — `lib/pilot-config.ts`)
# — same build-time-only requirement as BUILD_SHA above. No default
# values here: an omitted ARG/ENV pair is simply absent at build time,
# and `pilot-config.ts`'s own dev-safe fallbacks (demo data on, generic
# demo identity) apply exactly as they do outside Docker.
ARG NEXT_PUBLIC_DEMO_DATA_ENABLED
ENV NEXT_PUBLIC_DEMO_DATA_ENABLED=$NEXT_PUBLIC_DEMO_DATA_ENABLED
ARG NEXT_PUBLIC_PILOT_RESET_ENABLED
ENV NEXT_PUBLIC_PILOT_RESET_ENABLED=$NEXT_PUBLIC_PILOT_RESET_ENABLED
ARG NEXT_PUBLIC_COMPANY_NAME
ENV NEXT_PUBLIC_COMPANY_NAME=$NEXT_PUBLIC_COMPANY_NAME
ARG NEXT_PUBLIC_PILOT_USER_NAME
ENV NEXT_PUBLIC_PILOT_USER_NAME=$NEXT_PUBLIC_PILOT_USER_NAME
ARG NEXT_PUBLIC_PILOT_USER_EMAIL
ENV NEXT_PUBLIC_PILOT_USER_EMAIL=$NEXT_PUBLIC_PILOT_USER_EMAIL
# Client-side-only credential (see `pilot-config.ts`) — passed as a
# build arg, never written to this file or any other tracked file.
ARG NEXT_PUBLIC_PILOT_USER_PASSWORD
ENV NEXT_PUBLIC_PILOT_USER_PASSWORD=$NEXT_PUBLIC_PILOT_USER_PASSWORD

RUN pnpm build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Non-root process (Alpine's `addgroup`/`adduser`, not the Debian
# `useradd` syntax) — the standalone server never needs root.
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000

# `output: "standalone"` (next.config.ts) emits a self-contained
# server.js with its own trimmed node_modules — no `pnpm start` needed
# or available here.
CMD ["node", "server.js"]
